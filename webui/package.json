{
  "name": "wechat-article-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && pnpm run verify:assets",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "verify:assets": "node scripts/verify-assets.mjs",
    "check:release-size": "node scripts/check-release-size.mjs",
    "sync:go-assets": "node scripts/sync-go-assets.mjs",
    "verify:go-assets": "node scripts/sync-go-assets.mjs --check",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "check": "pnpm run lint && pnpm run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.55.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "gpt-tokenizer": "3.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
