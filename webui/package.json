{
  "name": "wechat-article-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run theme:build && pnpm run typecheck && vite build && pnpm run verify:assets",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "theme:build": "astryx theme build src/theme/workspaceTheme.source.ts --out src/styles/theme.css && node scripts/normalize-theme-build.mjs",
    "astryx:doctor": "astryx doctor",
    "verify:assets": "node scripts/verify-assets.mjs",
    "check:release-size": "node scripts/check-release-size.mjs",
    "sync:go-assets": "node scripts/sync-go-assets.mjs",
    "verify:go-assets": "node scripts/sync-go-assets.mjs --check",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "pnpm run theme:build && pnpm run lint && pnpm run typecheck && pnpm run astryx:doctor"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.6",
    "@astryxdesign/theme-neutral": "0.1.6",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.6",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.55.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "gpt-tokenizer": "3.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
