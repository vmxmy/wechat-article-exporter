{
  "name": "@ziikoo/wechat-article",
  "version": "2.0.0",
  "description": "Remote-only CLI for WeChat article export over OAuth-protected MCP",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechat-article/wechat-article-exporter.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/wechat-article/wechat-article-exporter/tree/main/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/wechat-article/wechat-article-exporter/issues"
  },
  "keywords": ["wechat", "wechat-official-account", "mcp", "cli", "article-export"],
  "files": ["dist/cli", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.1",
  "bin": {
    "wechat-article": "dist/cli/wechat-article.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli/wechat-article.js', 0o755)\"",
    "cli": "node dist/cli/wechat-article.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pack:dry": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "@cloudflare/workers-types": "4.20260603.1",
    "@types/node": "^24.13.3",
    "agents": "^0.2.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@cloudflare/workers-types": "4.20260603.1"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/workers-types": "4.20260603.1"
    }
  }
}
