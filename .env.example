# 调试微信代理请求 (仅开发环境(development)支持)
NUXT_DEBUG_MP_REQUEST=false

# AG-Grid 企业版授权
NUXT_AGGRID_LICENSE=

# KV绑定(本地/docker)
NITRO_KV_DRIVER=fs
NITRO_KV_BASE=.data/kv

# KV绑定(cloudflare)
#NITRO_KV_DRIVER=cloudflare-kv-binding

# D1 元数据持久化(默认开启)：元数据小表(article/info/metadata/comment/comment_reply/resource-map)
# 按账号隔离镜像到 Cloudflare D1，作为跨设备读权威；Blob 表(html/asset/resource/debug)保持纯本地。
# 生产部署到 CF Pages 时需在后台注入 NUXT_D1_CACHE_ENABLED=true 才真正生效。
NUXT_D1_CACHE_ENABLED=true
#NITRO_D1_BINDING=DB
#NITRO_D1_TABLE=cache_entries

DEBUG_KEY=

# WeChat AboutBiz 端点凭据（get_account_details / beta/aboutbiz API 必需）
# NUXT_WECHAT_ABOUT_BIZ_WX_HEADER=
# NUXT_WECHAT_ABOUT_BIZ_UIN=
# NUXT_WECHAT_ABOUT_BIZ_KEY=

# Sentry 错误追踪（可选）
# NUXT_SENTRY_DSN=
# NUXT_SENTRY_ORG=
# NUXT_SENTRY_PROJECT=
# NUXT_SENTRY_AUTH_TOKEN=

# 统计分析（可选）
# NUXT_UMAMI_ID=
# NUXT_UMAMI_HOST=

# PDF 生成 — Puppeteer 可执行文件路径（Docker / 自托管 PDF 必需）
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Nitro 部署目标（cloudflare-pages / node-server 等）
# NITRO_PRESET=cloudflare-pages

# 调试微信代理请求（仅开发环境，设为 "true" 开启）
# NUXT_DEBUG_MP_REQUEST=
